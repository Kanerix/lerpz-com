{
    "name": "lerpz-ai",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "dev": "bun --filter @lerpz/app dev",
        "dev:www": "bun --filter @lerpz/www dev",
        "build": "bun --filter './svc/*' build",
        "start": "bun --filter @lerpz/app start",
        "check": "bun --filter '*' check",
        "lint": "bun --filter '*' lint",
        "format": "bun --filter '*' format",
        "generate:api": "bun --filter @lerpz/app generate:api"
    },
    "workspaces": [
        "packages/*",
        "svc/app",
        "svc/www"
    ],
    "engines": {
        "bun": ">=1.4.0"
    },
    "packageManager": "bun@1.4.0-canary.1",
    "devDependencies": {
        "@biomejs/biome": "2.5.0",
        "@lerpz/biome-config": "workspace:*",
        "@lerpz/typescript-config": "workspace:*"
    }
}
