{
    "extends": "@lerpz/typescript-config/base.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "verbatimModuleSyntax": true,
        "paths": {
            "@lerpz/ui/*": ["./src/*"]
        }
    },
    "include": ["./**/*.ts", "./**/*.svelte"],
    "exclude": ["node_modules", "dist"]
}
