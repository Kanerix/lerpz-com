{
    "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
    "extends": ["@lerpz/biome-config/svelte"],
    "files": {
        "ignoreUnknown": true,
        "includes": ["**", "!**/*.svg"]
    },
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "linter": {
        "rules": {
            "correctness": {
                "useExhaustiveDependencies": "info"
            }
        }
    }
}
